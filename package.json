    "@huggingface/transformers": "^4.3.1",
    "express": "^5.3.0",
    "katex": "^0.16.47",
    "lucide-react": "^1.61.0",
    "mammoth": "^1.13.0",
    "multer": "^2.5.0",
    "openai": "^7.43.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "unpdf": "^1.9.1"
