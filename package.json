{
  "name": "caderno",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Caderno de estudos com IA: resumos, exercícios, documentos e chat sobre seus materiais.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"tsx watch server/index.ts --dev\" \"vite\"",
